# Azure Speech Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
# Optional. Use this for Azure AI Foundry/custom resource endpoints.
# Example: https://your-resource-name.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
AZURE_STT_LANGUAGE=en-US
AZURE_TTS_VOICE=en-US-JennyNeural

# OpenRouter / LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_ENDPOINT_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
MAX_TOKENS=150
TEMPERATURE=0.7

# Redis / Valkey Session Store
REDIS_URL=redis://localhost:6379
SESSION_TIMEOUT=3600

# Exotel Telephony Configuration
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=your_exotel_subdomain
EXOTEL_PHONE_NUMBER=+91xxxxxxxxxx
EXOTEL_USE_STREAM=false

# Server Configuration
HOST=0.0.0.0
PORT=8080
KOYEB_APP_URL=localhost:8080
